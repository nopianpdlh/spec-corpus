{
  "name": "spec-corpus-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "spec-corpus-root",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20",
        "npm": ">=10"
      }
    },
    "node_modules/@spec-corpus/corpus": {
      "resolved": "packages/corpus",
      "link": true
    },
    "node_modules/spec-corpus": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "spec-corpus",
      "version": "0.1.3",
      "license": "MIT",
      "bin": {
        "spec-corpus": "bin/spec-corpus.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/corpus": {
      "name": "@spec-corpus/corpus",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    }
  }
}
